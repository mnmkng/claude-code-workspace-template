{
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "WebFetch",
      "WebSearch",

      "mcp__claude_ai_Apify__search-actors",
      "mcp__claude_ai_Apify__fetch-actor-details",
      "mcp__claude_ai_Apify__fetch-apify-docs",
      "mcp__claude_ai_Apify__search-apify-docs",
      "mcp__claude_ai_Apify__get-actor-output",
      "mcp__claude_ai_Apify__get-actor-run",
      "mcp__claude_ai_Apify__apify--rag-web-browser",

      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-search",

      "mcp__redash__execute_adhoc_query",
      "mcp__redash__execute_query",
      "mcp__redash__get_query",
      "mcp__redash__list_queries",
      "mcp__redash__list_data_sources",
      "mcp__redash__create_query",
      "mcp__redash__update_query",

      "Bash(ls:*)",
      "Bash(find:*)",
