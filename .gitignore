# Ephemeral work folders (may contain nested git repos). The directory is
# committed via .gitkeep so the workspace structure is visible in git; the
# contents are ignored.
**/projects/**
!**/projects/.gitkeep

# Personal worklogs and personal context
WORKLOG.md
about.md
CLAUDE.local.md
CLAUDE.personal.md

# LLM conversations (may contain sensitive info)
**/.conversations/

# Personal settings
**/settings.local.json

# Environment and secrets
.env*
!.env.example
.mcp.json

# Hook logs (normally written to $HOME, this is defensive)
**/.claude/logs/

# Dependencies
**/node_modules/

# Python bytecode (tools/bootstrap)
**/__pycache__/
*.pyc

# Bootstrap composition artifacts (generated by tools/bootstrap)
.claude/.bootstrap-manifest.json
.claude/.bootstrap-copied-files
.claude/.bootstrap-log.txt

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# ===================================================================
# departments/ structure allowlist (default-deny)
# Only the canonical dept/team layout may be committed under
# departments/ (see CONTRIBUTING.md "Department and team folders").
# Anything else - stray folders, data dumps, identity tables, personal
# notes - is ignored automatically, with no per-file entries. Extend
# the allowlist in a reviewed change to permit a new artifact type.
# ===================================================================
departments/**

# descend into every directory so the allowlist below can match
!departments/**/

# ---- department root: departments/<dept>/ ----
!departments/*/CLAUDE.md
!departments/*/README.md
!departments/*/context/**/*.md
!departments/*/context/**/*.html
!departments/*/context/**/*.csv
!departments/*/context/**/*.json
!departments/*/docs-for-humans/**
!departments/*/.claude/agents/*.md
!departments/*/.claude/commands/*.md
!departments/*/.claude/rules/*.md
!departments/*/.claude/hooks/*.sh
!departments/*/.claude/skills/**
!departments/*/projects/.gitkeep

# ---- team / sub-team root: <any>/teams/<team>/ ----
!departments/**/teams/*/CLAUDE.md
!departments/**/teams/*/README.md
!departments/**/teams/*/context/**/*.md
!departments/**/teams/*/context/**/*.html
!departments/**/teams/*/context/**/*.csv
!departments/**/teams/*/context/**/*.json
!departments/**/teams/*/docs-for-humans/**
!departments/**/teams/*/.claude/agents/*.md
!departments/**/teams/*/.claude/commands/*.md
!departments/**/teams/*/.claude/rules/*.md
!departments/**/teams/*/.claude/hooks/*.sh
!departments/**/teams/*/.claude/skills/**
!departments/**/teams/*/projects/.gitkeep

# ---- team security settings (generator-owned) ----
# Stamped by `python3 tools/bootstrap/bootstrap.py settings-sync` into every
# tracked CLAUDE.md-bearing folder so Desktop-local sessions opened at a team
# folder load the security policy. Never hand-edited (see CONTRIBUTING.md).
!departments/*/.claude/settings.json
!departments/**/teams/*/.claude/settings.json
# If a tracked CLAUDE.md ever sits outside the canonical patterns, the
# generator hard-fails when its stamp would be ignored: add the stamp path
# here explicitly or restructure the folder.

# ---- never commit, even inside an allowed folder/type ----
departments/**/*.local.*
departments/**/.env*
departments/**/settings.local.json
departments/**/.mcp.json
# OS/editor/dependency junk otherwise resurrected by the !.../** re-includes
departments/**/.DS_Store
departments/**/Thumbs.db
departments/**/*.swp
departments/**/*.swo
departments/**/*~
departments/**/.idea/
departments/**/.vscode/
departments/**/node_modules/
departments/**/__pycache__/
departments/**/*.pyc
# projects/ is ephemeral working space: re-ignore its contents. The
# !departments/**/ directory re-include above resurrects directories under
# projects/, including embedded git repos, which a bulk `git add` would
# stage as gitlinks. Re-assert the ignore, then restore .gitkeep.
departments/**/projects/**
!departments/**/projects/.gitkeep
# CLAUDE.md defines an inheritance level - only valid at a dept/team root
departments/**/context/**/CLAUDE.md
departments/**/docs-for-humans/**/CLAUDE.md
